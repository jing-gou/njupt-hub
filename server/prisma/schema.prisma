generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  email     String     @unique
  role      UserRole   @default(USER)
  createdAt DateTime   @default(now())
  resources Resource[]
  reviews   Review[]
  likes     Like[]
  replies   Reply[]
  reports   Report[]
}

model Resource {
  id            Int            @id @default(autoincrement())
  title         String
  description   String?
  fileUrl       String
  course        String
  downloadCount Int            @default(0)
  createdAt     DateTime       @default(now())
  uploaderId    Int
  status        ResourceStatus @default(PENDING)
  updatedAt     DateTime       @updatedAt
  category      String?
  fileKey       String?
  fileName      String?
  fileSize      Int?
  mimeType      String?
  uploader      User           @relation(fields: [uploaderId], references: [id])

  @@index([status])
  @@index([course])
  @@index([category])
  @@index([uploaderId], map: "Resource_uploaderId_fkey")
}

model Review {
  id         Int            @id @default(autoincrement())
  rating     Float
  comment    String?
  ip         String?
  createdAt  DateTime       @default(now())
  reviewerId Int
  updatedAt  DateTime       @updatedAt
  imageUrl   String?
  itemId     Int
  item       ReviewableItem @relation(fields: [itemId], references: [id])
  reviewer   User           @relation(fields: [reviewerId], references: [id])
  likes      Like[]
  replies    Reply[]
  reports    Report[]

  @@index([itemId], map: "Review_itemId_fkey")
  @@index([reviewerId], map: "Review_reviewerId_fkey")
}

model Like {
  id        Int      @id @default(autoincrement())
  userId    Int
  reviewId  Int
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, reviewId])
  @@index([reviewId], map: "Like_reviewId_fkey")
}

model Reply {
  id        Int      @id @default(autoincrement())
  content   String
  userId    Int
  reviewId  Int
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([reviewId], map: "Reply_reviewId_fkey")
  @@index([userId], map: "Reply_userId_fkey")
}

model Report {
  id        Int      @id @default(autoincrement())
  reason    String
  userId    Int
  reviewId  Int
  createdAt DateTime @default(now())
  review    Review   @relation(fields: [reviewId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([reviewId], map: "Report_reviewId_fkey")
  @@index([userId], map: "Report_userId_fkey")
}

model ReviewableItem {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  type        Project
  location    String?
  college     String?
  avgRating   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reviews     Review[]
}

enum UserRole {
  USER
  ADMIN
  DEV
}

enum ResourceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Project {
  MENTOR
  CANTEEN
  TAKEOUT
}
